export component Slider {

    content: slot
    class: ?string

    # todo no arrays and spreads! attributes = Neos.Fusion:DataStructure
    # options = Neos.Fusion:DataStructure {
    #     # The gap between slides. The CSS format is acceptable, such as 1em.
    #     gap = 12
